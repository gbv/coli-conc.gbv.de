<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;700&display=swap"
    rel="stylesheet"
  >

  <style>
    {% for css_ in css %}
      {% include "css/" + css_ + ".css" %}
    {% endfor %}
  </style>
</head>

<body>

  {{ content | safe }}

  <script>
    function showSection(name, button) {
      document.querySelectorAll(".bk-tab").forEach(section => {
        const isActive = section.classList.contains(name)
        section.hidden = !isActive
        section.classList.toggle("active", isActive)
      })
      document.querySelectorAll(".nav-btn").forEach(navButton => {
        const isActive = navButton === button
        navButton.classList.toggle("primary", isActive)
        navButton.setAttribute("aria-pressed", isActive)
      })
    }

    function navTo(name) {
      const button = document.querySelector(`.nav-btn[data-section="${name}"]`)
      showSection(name, button)
      window.scrollTo({ top: 0, behavior: "smooth" })
    }

    showSection("projekt", document.querySelector('.nav-btn[data-section="projekt"]'))
  </script>
</body>
</html>
